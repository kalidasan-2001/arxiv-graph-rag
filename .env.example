# Copy this file to .env and adjust values for local development.
# Never commit a real .env file.

# --- Application ---
APP_NAME=arxiv-graph-rag-api
APP_ENV=development
APP_DEBUG=true

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Logging ---
LOG_LEVEL=INFO

# --- PostgreSQL: metadata + ingestion control plane ---
# When running the API via `docker compose up`, DATABASE_URL is overridden
# in docker-compose.yml to use the `postgres` service hostname instead of
# localhost -- this value is for running the API/alembic/tests on the host.
DATABASE_URL=postgresql+psycopg://arxiv:arxiv@localhost:5432/arxiv_graph_rag

# --- arXiv discovery ---
ARXIV_REQUEST_TIMEOUT_SECONDS=15
ARXIV_DEFAULT_MAX_RESULTS=20
ARXIV_MAX_RESULTS_LIMIT=100
ARXIV_MAX_RETRIES=2

# --- Raw PDF acquisition + storage ---
# In Docker Compose, PAPER_STORAGE_PATH is overridden to an absolute path
# backed by a persistent named volume (see docker-compose.yml).
PAPER_STORAGE_PATH=./data/papers
MAX_PAPER_SIZE_MB=50
PDF_DOWNLOAD_TIMEOUT_SECONDS=30
PDF_DOWNLOAD_MAX_RETRIES=2

# --- Section-aware chunking ---
CHUNKING_VERSION=v1
CHUNK_SIZE_TOKENS=700
CHUNK_OVERLAP_TOKENS=100
MIN_CHUNK_TOKENS=80

# --- Qdrant vector store ---
# In Docker Compose, QDRANT_URL is overridden to the `qdrant` service
# hostname -- this value is for running the API/scripts/tests on the host.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=scientific_chunks
# Optional -- local Docker Qdrant has no auth by default.
QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=30

# --- Neo4j knowledge graph ---
# In Docker Compose, NEO4J_URI is overridden to the `neo4j` service
# hostname -- this value is for running the API/scripts/tests on the host.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j
NEO4J_TIMEOUT_SECONDS=30

# --- Canonical entity resolution ---
CANONICALIZATION_VERSION=v1

# --- LLM provider ---
# V1's only implementation talks the OpenAI-compatible chat-completions
# HTTP API. LLM_BASE_URL is required (no safe default -- unlike Qdrant,
# silently falling back to a real cloud endpoint could send paper text to
# a paid third-party service). Point it at a local LM Studio server
# (typically http://localhost:1234/v1, or http://host.docker.internal:1234/v1
# from inside Docker Compose) or any OpenAI-compatible endpoint. Never
# required for the rest of the API -- only /extract-graph needs it.
LLM_PROVIDER=openai_compatible
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.0

# --- Scientific knowledge extraction ---
EXTRACTION_VERSION=v1

# --- Embedding provider ---
# V1's only implementation is local sentence-transformers -- no API key
# needed. The model downloads from Hugging Face on first use and is
# cached locally (see docs/ARCHITECTURE.md).
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu
EMBEDDING_NORMALIZE=true

# --- Vector search ---
VECTOR_SEARCH_DEFAULT_TOP_K=5
VECTOR_SEARCH_MAX_TOP_K=50

# --- Graph retrieval ---
GRAPH_MAX_DEPTH=3
GRAPH_DEFAULT_LIMIT=20
GRAPH_MAX_LIMIT=100
EVIDENCE_MAX_SUPPORTING_CHUNKS=5

# --- Hybrid retrieval ---
HYBRID_RRF_K=60
HYBRID_DEFAULT_TOP_K=10
HYBRID_MAX_TOP_K=50

# --- Query analysis and retrieval planning ---
QUERY_ANALYSIS_PROMPT_VERSION=v1
QUERY_ANALYSIS_SCHEMA_VERSION=v1
QUERY_PLANNER_VERSION=v1
QUERY_PLANNER_RULES_VERSION=v1
MAX_RETRIEVAL_ROUNDS=2
EVIDENCE_CRITIC_PROMPT_VERSION=v1
EVIDENCE_CRITIC_SCHEMA_VERSION=v1
EVIDENCE_CRITIC_RULES_VERSION=v1

# --- Grounded answer generation ---
ANSWER_GENERATION_PROMPT_VERSION=v1
ANSWER_GENERATION_SCHEMA_VERSION=v1
ANSWER_CONTEXT_BUILDER_VERSION=v1
ANSWER_MAX_EVIDENCE_ITEMS=10
ANSWER_MAX_CONTEXT_CHARS=30000
ANSWER_MAX_OUTPUT_TOKENS=800

# --- Citation validation ---
CITATION_VALIDATOR_VERSION=v1
CITATION_MARKER_SCHEMA_VERSION=v1

# --- Final grounding / confidence gates ---
GROUNDING_RULES_VERSION=v1
CONFIDENCE_RULES_VERSION=v1
ABSTENTION_TEMPLATE_VERSION=v1
